# Core
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USERS=1249515105
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_GENERAL=qwen3.5:9b
OLLAMA_MODEL_CODER=qwen2.5-coder:7b
OLLAMA_MODEL_FAST=qwen3.5:4b
OLLAMA_MODEL_EMBED=bge-m3
OLLAMA_MODEL_UNCENSORED=dolphin-mistral:7b

# Email / alerts
RESEND_API_KEY=replace_me
RESEND_FROM=agent@example.com
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_ALLOWLIST=you@example.com

# Data providers
HELIUS_API_KEY=replace_me

# Runtime
DATA_DIR=./data
LOG_LEVEL=INFO
ENABLE_BROWSER=false
ENABLE_UNCENSORED_FALLBACK=false
ENABLE_SELF_IMPROVE=true
ENABLE_CRYPTO=true
ENABLE_AI_DIGEST=true
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_MODE=fast

# Safety
MAX_TOOL_CALLS_PER_TASK=8
DEFAULT_TIMEOUT_SECONDS=60
